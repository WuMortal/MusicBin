{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "音藏默认权限：窗口、文件选择、打开本地文件",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "updater:default"
  ]
}
